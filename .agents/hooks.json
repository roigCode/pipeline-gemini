{
  "project-permissions": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|replace_file_content|multi_replace_file_content|read_file|view_file|view_file_outline|view_code_item|search_web|read_url_content|browser_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/check-permissions.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
